POSTGRES_DB=debugsql
POSTGRES_USER=debugsql
POSTGRES_PASSWORD=debugsql_dev_password
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql+psycopg://debugsql:debugsql_dev_password@postgres:5432/debugsql

DEBUGSQL_AUTO_LOGIN=1
DEBUGSQL_DEV_USER_EMAIL=dev@debugsql.local
DEBUGSQL_DEV_USER_NAME=DebugSQL Dev User
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173
SESSION_SECRET=change_me_in_production
AUTH_COOKIE_NAME=debugsql_session
AUTH_COOKIE_SECURE=false
JWT_SECRET=change_me_in_production

EMAIL_LOGIN_CODE_TTL_MINUTES=10
EMAIL_LOGIN_RESEND_SECONDS=60
EMAIL_LOGIN_MAX_ATTEMPTS=5
EMAIL_DEV_LOG_CODES=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DebugSQL <no-reply@debugsql.local>
SMTP_USE_TLS=1
SMTP_USE_SSL=0

NL2IR_PROVIDER=stub
NL2IR_CUSTOM_BASE_URL=
NL2IR_CUSTOM_API_KEY=
NL2IR_MODEL=
KDDCUP_AGENT_MODEL=gpt-4.1-mini
KDDCUP_AGENT_API_BASE=https://api.openai.com/v1
KDDCUP_AGENT_API_KEY=
KDDCUP_AGENT_MAX_STEPS=8
KDDCUP_AGENT_TIMEOUT_SECONDS=120
KDDCUP_WORK_DIR=/tmp/debugsql-kddcup

IR_TO_PLAN_PROVIDER=stub
IR_TO_PLAN_API_URL=
IR_TO_PLAN_API_KEY=
IR_TO_PLAN_TIMEOUT_SECONDS=30

BENCHMARK_HOST_DATA_DIR=./data/benchmarks
BENCHMARK_DATA_DIR=/app/data/benchmarks

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://backend:8000
VITE_USE_MOCK_SERVICES=false
VITE_SHOW_DEV_AUTH_NOTE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
