# DebugSQL server deployment template.
# Copy this file to .env on the Linux server and replace placeholder secrets.

POSTGRES_DB=debugsql
POSTGRES_USER=debugsql
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql+psycopg://debugsql:change_this_postgres_password@postgres:5432/debugsql

# Email verification login mode. Set to 1 only for private dev auto-login.
DEBUGSQL_AUTO_LOGIN=0
DEBUGSQL_DEV_USER_EMAIL=dev@debugsql.local
DEBUGSQL_DEV_USER_NAME=DebugSQL Dev User

APP_BASE_URL=http://39.107.112.225/api
FRONTEND_BASE_URL=http://39.107.112.225
SESSION_SECRET=change_this_to_a_long_random_string
AUTH_COOKIE_NAME=debugsql_session
AUTH_COOKIE_SECURE=false

JWT_SECRET=change_this_to_a_long_random_string

EMAIL_LOGIN_CODE_TTL_MINUTES=10
EMAIL_LOGIN_RESEND_SECONDS=60
EMAIL_LOGIN_MAX_ATTEMPTS=5
EMAIL_DEV_LOG_CODES=1
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=debugsql@163.com
SMTP_PASSWORD=your_163_smtp_authorization_code
SMTP_FROM=DebugSQL <debugsql@163.com>
SMTP_USE_TLS=0
SMTP_USE_SSL=1

NL2IR_PROVIDER=kddcup
NL2IR_CUSTOM_BASE_URL=
NL2IR_CUSTOM_API_KEY=
NL2IR_MODEL=
# KDDCUP_LLM_API_KEY is an LLM (OpenAI-compatible) API key, NOT a key from the
# KDDCup website. The vendored KDDCup data-agent baseline is a ReAct agent driven
# by an LLM, so it needs a key to call the model set in KDDCUP_AGENT_MODEL.
# KDDCUP_AGENT_API_BASE can point to any OpenAI-compatible endpoint (OpenAI,
# a self-hosted vLLM/Ollama gateway, another provider, etc.); set the key/model
# to match that endpoint. If left empty, the kddcup provider returns an
# inspectable agent_trace_error IR instead of inventing SQL.
# (Legacy name KDDCUP_AGENT_API_KEY still works as a backward-compatible alias.)
KDDCUP_AGENT_MODEL=gpt-4.1-mini
KDDCUP_AGENT_API_BASE=https://api.openai.com/v1
KDDCUP_LLM_API_KEY=
KDDCUP_AGENT_MAX_STEPS=8
KDDCUP_AGENT_TIMEOUT_SECONDS=120
KDDCUP_WORK_DIR=/tmp/debugsql-kddcup

IR_TO_PLAN_PROVIDER=internal
IR_TO_PLAN_API_URL=
IR_TO_PLAN_API_KEY=
IR_TO_PLAN_TIMEOUT_SECONDS=30

# Keep large benchmark files on the server data disk, not in Git.
BENCHMARK_HOST_DATA_DIR=/data/debugsql/data/benchmarks
BENCHMARK_DATA_DIR=/app/data/benchmarks

BACKEND_PORT=8000
FRONTEND_PORT=80
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://backend:8000
VITE_USE_MOCK_SERVICES=false
VITE_SHOW_DEV_AUTH_NOTE=false
CORS_ORIGINS=http://39.107.112.225,http://39.107.112.225:80,http://localhost:5173,http://127.0.0.1:5173
